#!/bin/sh
#
# (c) 2026, Roberto A. Foglietta <roberto.foglietta@gmail.com>, MIT license
#

exec 3>/dev/null

getvarval() {
  grep "$1" $MUSLCFGMAK | cut -d# -f1 | tr -dc 0-9. | tail -n1;
}
getnstime() { date +%s%N; }
elapsedns() { echo $((  $(getnstime) - $1 )); }
elapsedus() { echo $(( ($(elapsedns    $1) + 500) / 1000 )); }
elapsedms() { echo $(( ($(elapsedus    $1) + 500) / 1000 )); }
elapsedtm() { echo $(( ($(elapsedms    $1) + 500) / 1000 )); }

export MUSLCFGMAK=cnfg/musl-125x.config.mak

export ARCH=x86_64 KERNVER=$(getvarval LINUX_VER)

path="musl/output"
kmod="uchaos_dev.ko"
bcfg=$(ls -1 cnfg/busybox-*.config | tail -n1)
kver=$(echo $KERNVER | tr -dc 0-9 | head -c3)x
kdir="musl/linux-$KERNVER.orig"
lnxpath="kdev/linux-kernel"
ncpu=$(nproc)
export PATH=$PWD/$path/bin:$PWD/$path/$ARCH/bin:$PATH
export CCPREFIX=$ARCH-linux-musl- HOSTCC=gcc
unset path

# //////////////////////////////////////////////////////////////////////////////

if false; then
  for dir in musl bbox kdev usrl prnd $lnxpath; do
    make clean -C $dir &
  done
  rm -rf gzcmd.sh gzcmd.sh.gz cpio.cpio cpio/
  git checkout cpio/
  wait
fi

# //////////////////////////////////////////////////////////////////////////////

start=$(getnstime)
git submodule update --init --recursive
dlcmd=$(grep -e DL_CMD musl/config.mak | cut -d# -f1 | cut -d= -f2)
url="https://raw.githubusercontent.com/robang74/bare-minimal-linux-system"
trg="refs/heads/main"
$dlcmd gzcmd.sh $url/$trg/gzcmd.sh &&
  sh gzcmd.sh gzcmd.sh gzcmd
echo "updating and download time: "$(elapsedtm start)s

# //////////////////////////////////////////////////////////////////////////////

start=$(getnstime)
test -r musl/config.mak || cp $MUSLCFGMAK musl/config.mak
cp -arf cnfg/hashes musl/
make -j$ncpu -C musl install
du -ms musl/output/
echo "musl building elapsed time: "$(elapsedtm start)s

# //////////////////////////////////////////////////////////////////////////////

start=$(getnstime)
ln -sf ../$kdir $lnxpath
cp -f cnfg/linux-$kver.config $lnxpath/.config
opts="HOSTCC=gcc ARCH=$ARCH -C $lnxpath CROSS_COMPILE=${CCPREFIX}"
make -j$ncpu $opts syncconfig
make -j$ncpu $opts bzImage modules_prepare
du -k $kdir/arch/$ARCH/boot/bzImage
echo "linux kernel building time: "$(elapsedtm start)s

# //////////////////////////////////////////////////////////////////////////////

start=$(getnstime)
test -r bbox/.config || cp $bcfg bbox/.config
opts="HOSTCC=gcc ARCH=$ARCH -C bbox CROSS_COMPILE=${CCPREFIX}"
make -j$ncpu $opts oldconfig
make -j$ncpu $opts busybox
du -k bbox/busybox
echo "busybox custom making time: "$(elapsedtm start)s

# //////////////////////////////////////////////////////////////////////////////

start=$(getnstime)
cd minz
sh amalgamate.sh
cd ..
ln -sf $kdir/ kdev
make -j$ncpu -C kdev CROSS_COMPILE=${CCPREFIX} dist
make -j$ncpu -C usrl CCPREFIX=${CCPREFIX} uchaosbox
du -k kdev/$kmod.gz
echo "uchaos proj compiling time: "$(elapsedtm start)s

# //////////////////////////////////////////////////////////////////////////////

start=$(getnstime)
make -j$ncpu -C prnd/ CCSYSROOT="-static -mavx2" CCPREFIX=${CCPREFIX} RNG_test
du -k prnd/RNG_test
echo "RNG_test static build time: "$(elapsedtm start)s

# //////////////////////////////////////////////////////////////////////////////

unset start opts

cp -f $kdir/arch/$ARCH/boot/bzImage qemu/

chmod +x               cpio/init

mkdir -p               cpio/tmp/
mkdir -p               cpio/var/log/
mkdir -p               cpio/lib/modules/
mkdir -p               cpio/usr/bin/

cp -f  kdev/$kmod.gz   cpio/lib/modules/$kmod
cp -f  usrl/uchaosbox  cpio/usr/bin/
cp -f  bbox/busybox    cpio/usr/bin/

ln -sf bin             cpio/usr/sbin
ln -sf bin/busybox     cpio/linuxrc
ln -sf usr/sbin        cpio/sbin
ln -sf usr/bin         cpio/bin
ln -sf busybox         cpio/bin/sh

