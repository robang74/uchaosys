#!/bin/sh
#
# (c) 2026, Roberto A. Foglietta <roberto.foglietta@gmail.com>, MIT license
#

exec 3>/dev/null

# Functions ////////////////////////////////////////////////////////////////////

getvarval() {
  grep "$1" $MUSLCFGMAK | cut -d# -f1 | tr -dc 0-9. | tail -n1;
}
getnstime() { date +%s%N; }
elapsedns() { echo $((  $(getnstime) - $1 )); }
elapsedus() { echo $(( ($(elapsedns    $1) + 500) / 1000 )); }
elapsedms() { echo $(( ($(elapsedus    $1) + 500) / 1000 )); }
elapsedtm() { echo $(( ($(elapsedms    $1) + 500) / 1000 )); }

# Settings /////////////////////////////////////////////////////////////////////

export MUSLCFGMAK=cnfg/musl-125x.config.mak

export ARCH=x86_64 KERNVER=$(getvarval LINUX_VER)

path="musl/output"
kmod="uchaos_dev.ko"
bcfg=$(ls -1 cnfg/busybox-*.config | tail -n1)
kver=$(echo $KERNVER | tr -dc 0-9 | head -c3)x
kdir="musl/linux-$KERNVER.orig"
kimg=$kdir/arch/$ARCH/boot/bzImage
lnxpath="kdev/linux-kernel"
ncpu=$(nproc)
export PATH=$PWD/$path/bin:$PWD/$path/$ARCH/bin:$PATH
export CCPREFIX=$ARCH-linux-musl- HOSTCC=gcc
unset path

opts="HOSTCC=gcc ARCH=$ARCH CROSS_COMPILE=${CCPREFIX} CCPREFIX=${CCPREFIX}"

# target: sources //////////////////////////////////////////////////////////////

start=$(getnstime)
git submodule update --init --recursive
dlcmd=$(grep -e DL_CMD musl/config.mak | cut -d# -f1 | cut -d= -f2)
url="https://raw.githubusercontent.com/robang74/bare-minimal-linux-system"
trg="refs/heads/main"
$dlcmd gzcmd.sh $url/$trg/gzcmd.sh &&
  sh gzcmd.sh gzcmd.sh gzcmd
echo "updating and download time: "$(elapsedtm start)s

# target: toolchain ////////////////////////////////////////////////////////////

start=$(getnstime)
test -r musl/config.mak || cp $MUSLCFGMAK musl/config.mak
cp -arf cnfg/hashes musl/
eval make -j$ncpu -C musl install
du -ms musl/output/
echo "musl building elapsed time: "$(elapsedtm start)s

# target: bzImage //////////////////////////////////////////////////////////////

start=$(getnstime)
test -e $lnxpath || ln -sf ../$kdir $lnxpath
test -r $lnxpath/.config || cp -f cnfg/linux-$kver.config $kdir/.config
eval make -j$ncpu $opts -C $lnxpath syncconfig modules_prepare bzImage modules
du -Lk $kimg
echo "linux kernel building time: "$(elapsedtm start)s

# target: busybox //////////////////////////////////////////////////////////////

start=$(getnstime)
test -r bbox/.config || cp $bcfg bbox/.config
eval make -j$ncpu $opts -C bbox oldconfig
eval make -j$ncpu $opts -C bbox busybox
du -k bbox/busybox
echo "busybox custom making time: "$(elapsedtm start)s

# target: uchaos ///////////////////////////////////////////////////////////////

start=$(getnstime)
cd minz
sh amalgamate.sh
cd ..
ln -sf $kdir/ kdev
eval make -j$ncpu -C kdev $opts dist
eval make -j$ncpu -C usrl $opts uchaosbox
du -k kdev/$kmod.gz
echo "uchaos proj compiling time: "$(elapsedtm start)s

# target: rngtest //////////////////////////////////////////////////////////////

start=$(getnstime)
make -j$ncpu -C prnd/ CCSYSROOT="-static -mavx2" CCPREFIX=${CCPREFIX} RNG_test
du -k prnd/RNG_test
echo "RNG_test static build time: "$(elapsedtm start)s

# //////////////////////////////////////////////////////////////////////////////

unset start opts kopts
tmpd=cpio.tmp

if false; then
# target: clean ////////////////////////////////////////////////////////////////
  rm -rf gzcmd.sh gzcmd.sh.gz cpio.cpio $tmpd
  for dir in musl bbox kdev usrl prnd $lnxpath; do
    eval make -C $dir clean &
  done
  cp -arf cpio           $tmpd
  wait
else
# target: install //////////////////////////////////////////////////////////////
  sh cpio.sh -c

  mkdir -p               $tmpd/tmp/
  mkdir -p               $tmpd/var/log/
  mkdir -p               $tmpd/lib/modules/
  mkdir -p               $tmpd/usr/bin/

  cp -Lf $kimg           qemu/

  cp -f  kdev/$kmod.gz   $tmpd/lib/modules/$kmod
  cp -f  usrl/uchaosbox  $tmpd/usr/bin/
  cp -f  bbox/busybox    $tmpd/usr/bin/

  chmod +x               $tmpd/init

  ln -sf bin             $tmpd/usr/sbin
  ln -sf bin/busybox     $tmpd/linuxrc
  ln -sf usr/sbin        $tmpd/sbin
  ln -sf usr/bin         $tmpd/bin
  ln -sf busybox         $tmpd/bin/sh
fi

