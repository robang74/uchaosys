#

exec 3>/dev/null
export ARCH=x86_64
git submodule update --init --recursive
cd musl
make -j8 install
cd -
path="musl/output"
export PATH=$PWD/$path/bin:$PWD/$path/$ARCH/bin:$PATH
export CCPREFIX=x86_64-linux-musl- HOSTCC=gcc
unset path
cd minz
sh amalgamate.sh
cd -
cd usrl
make
cd -
ln -sf ../musl/linux-5.15.202.orig kdev/linux-kernel
cp -f cnfg/linux-515x.config kdev/linux-kernel/.config
cd kdev/linux-kernel/
make -j8 HOSTCC=gcc ARCH=x86_64 syncconfig
make -j8 HOSTCC=gcc ARCH=x86_64
cd kdev
make
cd -
